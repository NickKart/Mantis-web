{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mantis",
  "mainBinaryName": "mantis",
  "version": "0.1.0",
  "identifier": "ru.rcmit.mantis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "РСМ АйТи",
    "copyright": "© РСМ АйТи",
    "shortDescription": "Подсчёт посетителей витрины",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/mantis-agent"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Mantis"
      }
    }
  }
}
