{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mantis-page",
  "description": "Страница Mantis от встроенного Агента (только этот компьютер) вызывает команды оболочки.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": [
    "allow-app-info",
    "allow-keep-awake",
    "allow-set-autostart",
    "allow-quit-app",
    "allow-pilot-state",
    "allow-install-state",
    "allow-move-to-applications",
    "allow-open-settings",
    "allow-setup-done"
  ]
}
