{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mantis",
  "mainBinaryName": "mantis",
  "version": "0.1.0",
  "identifier": "ru.rcmit.mantis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.business",
    "copyright": "© РСМ АйТи",
    "shortDescription": "Подсчёт посетителей витрины",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/mantis-agent"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "../dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 470
        },
        "appPosition": {
          "x": 170,
          "y": 175
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 175
        }
      }
    }
  }
}
