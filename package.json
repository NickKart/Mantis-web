{
  "name": "mantis-web",
  "private": true,
  "version": "0.1.0",
  "description": "Mantis в браузере: проверка подсчёта посетителей витрины на своём видео",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p legacy && vite build && vite build --config legacy/vite.config.ts",
    "build:server": "node server/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p legacy",
    "serve": "node bridge/serve.mjs",
    "agent": "bash agent/build.sh",
    "server": "node server/dist/server.cjs",
    "build:b": "vite build --config legacy/vite.config.ts",
    "dev:b": "vite --config legacy/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "jose": "6.2.15",
    "onnxruntime-web": "1.30.0",
    "preact": "10.26.9"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "bun": "1.4.2",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
